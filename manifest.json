{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "BotDetector",
  "version": "1.0.0",
  "description": "A bot detection extension for identifying troll and astroturfing accounts",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://t.co/*",
    "https://bit.ly/*",
    "https://tinyurl.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "botdetector@rileymeyerkorth.com",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    }
  },
  "homepage_url": "https://rileymeyerkorth.com",
  "short_name": "BD",
  "background": {
    "scripts": ["src/background.js"]
  },
  "icons": {
    "32": "assets/icon.png",
    "128": "assets/icon_4x.png"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*"],
      "js": ["src/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*"],
      "resources": ["src/inject.js"]
    }
  ],
  "commands": {
    "rescan": {
      "description": "Rescan the page for bots",
      "suggested_key": {
        "default": "Alt+R"
      }
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      }
    }
  },
  "action": {
    "default_title": "BotDetector",
    "default_popup": "popup.html"
  }
}
