{
  "name": "droiddetector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --config .prettierrc",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs --watch",
    "test": "jest",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-config-preact": "^2.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "decancer": "^4.0.0",
    "preact": "^11.0.1"
